<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.ae-mcp.watcher" ExtensionBundleVersion="1.1.0" ExtensionBundleName="AE MCP">
  <ExtensionList>
    <Extension Id="com.ae-mcp.watcher.panel" Version="1.1.0" />
    <Extension Id="com.ae-mcp.watcher.service" Version="1.1.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="AEFT" Version="[17.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="11.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <!-- Visible status panel: Window > Extensions > AE MCP -->
    <Extension Id="com.ae-mcp.watcher.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./client/index.html</MainPath>
          <ScriptPath>./host/watcher.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--allow-file-access</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>AE MCP</Menu>
          <Geometry>
            <Size>
              <Width>260</Width>
              <Height>220</Height>
            </Size>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
    <!-- Invisible background service: auto-starts the watcher when AE launches,
         and keeps it alive even if the panel is never opened -->
    <Extension Id="com.ae-mcp.watcher.service">
      <DispatchInfo>
        <Resources>
          <MainPath>./client/service.html</MainPath>
          <ScriptPath>./host/watcher.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--allow-file-access</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>false</AutoVisible>
          <StartOn>
            <Event>com.adobe.csxs.events.ApplicationActivate</Event>
          </StartOn>
        </Lifecycle>
        <UI>
          <Type>Custom</Type>
          <Geometry>
            <Size>
              <Width>1</Width>
              <Height>1</Height>
            </Size>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
